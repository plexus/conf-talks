#!/usr/bin/env bb

(require
 '[clojure.pprint :as pprint]
 '[lambdaisland.cli :as cli])

(defn update-id [data id f & args]
  (mapv (fn [m] (if (= (:id m) id) (apply f m args) m)) data))

(defn info
  "Get info on our starships"
  [{:keys [data] :as opts}]
  (pprint/print-table
   (for [{:keys [id name]} data]
     {:id id :name name})))

;; !! new command
(defn engines-info
  "Get info on your engines"
  [{:keys [data] :as opts}]
  (pprint/print-table
   (for [{:keys [id name engines]} data
         {engine-id :id :keys [state engaged? power]} engines]
     {:id id
      :name name
      :engine-id engine-id
      :state state
      :engaged? engaged?
      :power power})))

;; !! new command
(defn engines-engage
  "Engage the engine"
  {:flags ["--engine-id <id>" "Which engine to engage"]}
  [{:keys [ship engine-id data] :as opts}]
  (spit "out.edn"
        (with-out-str
          (pprint/pprint
           (update-id data ship update :engines update-id engine-id assoc :engaged? true)))))

(def engines
  {:commands ["info" #'engines-info
              "engage" #'engines-engage]})

(def commands
  ["info" #'info
   "engines" #'engines])

(def flags
  ["--ship <id>" "Choose which ship to operate on"
   "-f, --file <starship-file>"
   {:doc "Which starship.edn to operate on"
    :default "starship.edn"
    :handler (fn [opts file]
               (assoc
                 opts :data
                 (read-string
                  (slurp file))))}])

(cli/dispatch
 {:name "starship"
  :doc "Control a starship!
        Conveniently remote control your ships, whether in orbit or in deep space."
  :commands commands
  :flags flags})
