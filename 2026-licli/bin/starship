#!/usr/bin/env bb

(require
 '[clojure.pprint :as pprint]
 '[lambdaisland.cli :as cli])

(def init
  {:id "QTC"})

(defn list-ships
  "Show an overview of the ships"
  [opts]
  (pprint/print-table
   (for [{:keys [id name cargo]} (read-string (slurp "starship.edn"))]
     {:id id
      :name name
      :cargo
      (str
       (transduce (map :loaded) + cargo) "/"
       (transduce (map :capacity) + cargo))})))

(defn inspect-ship
  "Print the details of a ship"
  [{:keys [id] :as opts}]
  (pprint/pprint
   (some #(when (= id (:id %)) %)
         (read-string (slurp "starship.edn")))
   ))

(def commands
  ["list" #'list-ships
   "inspect" #'inspect-ship])

(def flags
  [])

(cli/dispatch
 {:name "starship"
  :init init
  :doc "Control a starship!"
  :commands commands
  :flags flags})

;; Local Variables:
;; mode:clojure
;; End:
