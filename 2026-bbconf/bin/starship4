#!/usr/bin/env bb

(require
 '[clojure.pprint :as pprint]
 '[lambdaisland.cli :as cli])

(defn info
  "Get info on our starships"
  [opts]
  (pprint/print-table
   (map #(select-keys % [:id :name])
        (read-string
         (slurp "starship.edn")))))

(def commands
  ["info" #'info])

(cli/dispatch
 {:name "starship"
  :doc "Control a starship! \n\n Conveniently remote control your ships, whether in orbit or in deep space."
  :commands commands})

