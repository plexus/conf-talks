#!/usr/bin/env bb

(require '[babashka.deps :as deps])
(deps/add-deps '{:deps {com.lambdaisland/cli {:mvn/version "1.29.127"}}})

(require
 '[clojure.pprint :as pprint]
 '[lambdaisland.cli :as cli])

(cli/dispatch
 {:name "starship"
  :doc "Control a starship! \n\n Conveniently remote control your ships, whether in orbit or in deep space."
  :command (fn [opts]
             (println "Starship stuff!")
             (pprint/pprint opts))})

